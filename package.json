{
  "name": "albertool-constellation-fullstack",
  "displayName": "Albertool Constellation FullStack",
  "description": "Gere projetos fullstack completos direto no VS Code — frontend, backend e um package.json global para instalar e rodar tudo com um único comando.",
  "version": "0.0.1",
  "publisher": "SidAlbertaodasmassa",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Scaffolders",
    "Programming Languages"
  ],
  "keywords": [
    "fullstack",
    "scaffold",
    "react",
    "node",
    "typescript",
    "boilerplate",
    "albertool"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "constellation.gerar",
        "title": "Constellation: Gerar Projeto"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}